{
  "name": "dsh-approval-allow",
  "version": "0.1.0",
  "engines": { "dsh": ">=0.2.2-rc.2" },
  "private": true,
  "type": "module",
  "description": "按全局/项目两级配置文件的锚定正则，自动同意 pwsh/bash 审批（含沙箱提权）；改配置即热生效，不重启 DSH。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/config.mjs": "./lib/config.mjs",
    "./lib/match.mjs": "./lib/match.mjs",
    "./lib/audit.mjs": "./lib/audit.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "DECISIONS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
